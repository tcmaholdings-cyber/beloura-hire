# beloura-hire .env — copy to .env and fill in. Never commit the real .env.
# Leaving a token empty puts that integration in dry-run (no external calls), which is how the tests run.

HIRE_PUBLIC_URL=https://example.com
AGENT_NAME=James
HIRE_SECRET=                      # random secret; signs the per-applicant assessment/thank-you links
HIRE_DB_PATH=/app/data/hire.db
BELOURA_GATEWAY_TOKEN=            # shared secret with your reverse proxy if you gate /staff behind SSO
PANEL_USER=admin
PANEL_PASSWORD=                   # HTTP Basic fallback for /staff on the direct port
TUNNEL_TOKEN=                     # Cloudflare tunnel token (used by the compose 'tunnel' sidecar)

# LLM gateway (OpenRouter). Empty key = dry-run with canned replies.
OPENROUTER_API_KEY=
SAM_MODEL=anthropic/claude-sonnet-5.5
SAM_FALLBACK_MODELS=deepseek/deepseek-chat
SAM_PRICES=anthropic/claude-sonnet-5.5=3,15;deepseek/deepseek-chat=0.3,1.2   # USD per million tokens in,out
SAM_TIMEOUT=60

# Telegram bot (raw Bot API). Empty token = dry-run.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_bot
TELEGRAM_WEBHOOK_SECRET=          # webhook path is /hooks/telegram/<secret>
TELEGRAM_STAFF_CHAT_ID=
HIRE_TELEGRAM_POLL=0              # 1 = long-polling for local dev (deletes the webhook)

# Discord bot (discord.py). Empty token = dry-run. Needs Message Content + Server Members intents.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_STAFF_CHANNEL_ID=

# Email (SMTP out, IMAP in). Empty SMTP_HOST = dry-run; empty IMAP_HOST = no reply polling.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_EHLO_NAME=
MAIL_FROM=Your Team <hello@example.com>
MAIL_REPLY_TO=hello@example.com
MAIL_SUBJECT=Your application
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX

HIRE_TICK_SECONDS=30
HIRE_IMAP_SECONDS=120
LOG_LEVEL=INFO
# HIRE_NO_WORKER=1                # tests and smoke runs only

# Assessment portal. Same OPENROUTER_API_KEY; empty key = dry-run (canned fan lines, heuristic grades).
SIM_MODEL=anthropic/claude-sonnet-5.5     # plays the fan in the live chats
SIM_FALLBACK_MODELS=deepseek/deepseek-chat
JUDGE_MODEL=anthropic/claude-opus-4.1     # grades the chats
JUDGE_FALLBACK_MODELS=anthropic/claude-sonnet-5.5
ASSESS_PRICES=
ASSESS_TIMEOUT=60
